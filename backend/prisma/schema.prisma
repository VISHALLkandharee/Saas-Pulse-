generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  Role         Role          @default(USER)
  image        String? // For profile pictures
  isBeta       Boolean       @default(false) // For early access tagging
  createdAt    DateTime      @default(now())
  subscription Subscription?
  activities   Activity[]
  apiKeys      ApiKey[]
}

model ApiKey {
  id        String    @id @default(uuid())
  // `key` exists only for a short-lived legacy migration path. New secrets are
  // never persisted; their SHA-256 digest is used for authentication instead.
  key       String?   @unique
  keyHash   String?   @unique
  prefix    String?
  last4     String?
  name      String    @default("Default Key")
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  lastUsed  DateTime?
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  plan             Plan      @default(FREE)
  status           Status    @default(ACTIVE)
  mrr              Float     @default(0.0)
  stripeCustomerId String?   @unique
  expiry           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  event     String // e.g., "USER_SIGNUP", "PLAN_UPGRADE"
  metadata  Json?
  // Provider idempotency key. A provider can safely retry the same event.
  externalId String?
  // Time reported by the source system, distinct from persistence/audit time.
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, externalId])
  @@index([userId, occurredAt])
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  status    String   @default("PENDING") // PENDING or INVITED
  createdAt DateTime @default(now())
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum Status {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum Role {
  USER
  ADMIN
}
